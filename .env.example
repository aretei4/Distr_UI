# Copy this file to .env and fill in the value for your environment.
# VITE_ prefix is required — Vite only exposes variables with this prefix to the browser bundle.

# Local dev (Spring Boot running on port 8080)
VITE_API_BASE_URL=http://localhost:8080/api

# Production / server
# VITE_API_BASE_URL=https://device4autism.in/api

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
